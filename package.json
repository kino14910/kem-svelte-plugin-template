{
	"name": "kem-svelte-plugin-template",
	"version": "0.0.1",
	"private": true,
	"description": "使用 SvelteKit 和 Skeleton 编写的 KEM 示例插件",
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"files": [
		"dist/index.html",
		"host.mjs"
	],
	"kem": {
		"id": "example-counter",
		"apiVersion": 1,
		"title": "计数器",
		"description": "一个使用 Skeleton 主题的计数器",
		"client": {
			"entry": "./dist/index.html",
			"label": "计数器"
		},
		"host": "./host.mjs"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && node scripts/package-window.mjs",
		"prepack": "pnpm run build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "playwright install --only-shell chromium && vitest run && playwright test",
		"test:e2e": "playwright install --only-shell chromium && playwright test"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.1",
		"@skeletonlabs/skeleton": "^5.0.6",
		"@skeletonlabs/skeleton-svelte": "^5.0.6",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@vitest/browser-playwright": "^5.1.0",
		"playwright": "^1.65.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vite-plugin-singlefile": "^2.3.4",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.1.0"
	}
}
